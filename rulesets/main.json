{
  "id": 23510340,
  "name": "branch: main",
  "target": "branch",
  "source_type": "Repository",
  "source": "mathewmusango/my-workflows",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/main"
